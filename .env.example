# Database Connection
# For Local Development: sqlite:///./biometric_auth.db
# For Neon / Railway Production: postgresql://user:password@ep-xyz.neon.tech/neondb?sslmode=require
DATABASE_URL=sqlite:///./biometric_auth.db

# JWT & API Security
SECRET_KEY=continuous-auth-super-secret-key-for-mtech-dissertation-2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Allowed CORS Origins (comma-separated or wildcard pattern)
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","https://*.vercel.app","*"]

# Machine Learning Artifacts
MODEL_PATH=ml/saved_models/best_transformer.pt
